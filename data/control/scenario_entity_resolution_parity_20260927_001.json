  "audited_defect": "F1",
  "audited_defect_summary": "ScenarioCompiler._compile_waves resolved Monster placements with get_monster only, while ContentDatabase.get_stage_package resolved them with get_monster OR monster_variants. The two static identity rules disagreed for 823/6717 (12.2%) of the real 4.4.54 wave placements, so a Scenario Package could reject a Monster placement that the Stage Package reported RESOLVED (e.g. source_stage_id=420101 raised 'unknown monster: 100401401').",
  "branch": "terra/implementation",
  "starting_head": "24ccb9bc01f7e20bf215b9b1aa96f3e346e7ed2a",
  "resolution_rule": {
    "authority": "hsr_battle_agent.game_data.nanoka_content.ContentDatabase.resolve_monster",
    "shared_by": [
      "ContentDatabase.get_stage_package",
      "hsr_battle_agent.game_data.scenario_compiler.ScenarioCompiler._compile_waves"
    ],
    "precedence": [
      "canonical monsters record wins (resolved_kind=MONSTER)",
      "monster_variants record is accepted as an equally static second identity (resolved_kind=MONSTER_VARIANT)"
    ],
    "canonical_parent_rule": "A variant reports canonical_monster_id only when the variant payload's own monster_id field resolves to an existing monsters record; an unproven parent is reported as null rather than guessed.",
    "identity_fields": [
      "requested_id",
      "resolved_kind",
      "canonical_monster_id",
      "variant_id"
    ],
    "requested_id_policy": "The caller-requested monster_id is preserved verbatim; the canonical parent is never substituted for the requested identity.",
    "no_new_semantics": [
      "no fuzzy or name matching",
      "no cross-version fallback",
      "no parent invention",
      "no AI / skill / phase / execution semantics"
    ]
  },
