{
 "schema": "content_support_registry_contract/1",
 "version": "1.1.0",
 "content_version": "4.4.54",
 "change_request_id": "CR-M13-CONTENT-SUPPORT-REGISTRY-20260926-001",
 "purpose": "Canonical 4.4.54 capability registry for backend capability queries, planner filtering, future 4.4.54 -> 4.5.54 diff, future test selection and future frontend support display.",
 "not_an_execution_authority": true,
 "record_model": {
  "canonical_population": "one record per static AvatarID:SkillID",
  "canonical_record_count": 620,
  "covers_all_static_skill_rows": true,
  "no_separate_duplicate_view": "Unbound rows are canonical records with binding_level STATIC_ONLY. Any unbound index is a key projection only and does not duplicate record bodies.",
  "entry_ability_rule": "EntryAbility is never fabricated. The four trigger-matched rows without EntryAbility keep entry_ability = null."
 },
 "population_terminology": {
  "STATIC_SKILL_ROWS": 620,
  "EMPTY_TRIGGER_ROWS": 92,
  "TRIGGER_NAME_JOINED_ROWS": 528,
  "TRIGGER_JOINED_WITHOUT_ENTRY_ABILITY": 4,
  "ACTUAL_BEHAVIOR_ROOT_BOUND_OR_BETTER": 524,
  "TOTAL_STATIC_WITHOUT_BEHAVIOR_ROOT": 96,
  "historical_note": "M12's 528 is the historical trigger-name-joined population. M13 does not rewrite it; M13 reports the literal behavior-root-bound count as 524."
 },
 "unbound_reasons": [
  "EMPTY_TRIGGER_KEY",
  "TRIGGER_MATCHED_BUT_NO_ENTRY_ABILITY"
 ],
 "binding_levels": [
  {
   "level": "STATIC_ONLY",
   "meaning": "Static avatar/skill identity only; no behavior root (empty trigger key, or trigger matched but no EntryAbility)."
  },
  {
   "level": "BEHAVIOR_ROOT_BOUND",
   "meaning": "EntryAbility root named by the exact owner-scoped join; no full-closure census."
  },
  {
   "level": "FULL_ACTION_REPRESENTED",
   "meaning": "Full first-hop action closure is represented and its blockers are known. This does NOT mean executable."
  },
  {
   "level": "REFERENCE_SETTLEMENT_BOUND",
   "meaning": "FORBIDDEN for the current M12 evidence set. Not assigned to any record."
  },
  {
   "level": "CONTENT_ACTION_EXECUTABLE_REFERENCE",
   "meaning": "FORBIDDEN for the current M12 evidence set. Not assigned to any record."
  }
 ],
 "binding_level_definition_note": "BEHAVIOR_ROOT_BOUND requires a non-null EntryAbility. FULL_ACTION_REPRESENTED means the closure is represented and blockers are known; it does NOT mean executable.",
 "support_statuses": [
  "REPRESENTABLE_BLOCKED",
  "BLOCKED_BY_EVIDENCE",
  "BLOCKED_BY_REFERENCE_SUPPORT",
  "BLOCKED_BY_CONTINUATION",
  "NO_SETTLEMENT",
  "UNBOUND_STATIC_SKILL"
 ],
 "support_status_precedence": [
  "1. UNBOUND_STATIC_SKILL: no EntryAbility (empty trigger key, or trigger matched but no EntryAbility).",
  "2. BLOCKED_BY_CONTINUATION: second-hop TriggerAbility continuation present in a first-hop target (evaluated before packet blockers so continuation is never masked).",
  "3. NO_SETTLEMENT: no settlement operation in the represented closure.",
  "4. BLOCKED_BY_EVIDENCE: closure represented (census available) and the Wait-only residual blocker classes are a subset of {DAMAGE_PACKET, HEAL_PACKET}.",
  "5. BLOCKED_BY_REFERENCE_SUPPORT: closure represented, no structural/uncompiled classes remain, but reference-adapter support gaps remain.",
  "6. REPRESENTABLE_BLOCKED: closure represented (or root-record scope only) and uncompiled structural nodes remain."
 ],
 "no_supported_status": "No M12 real content action receives an executable or SUPPORTED status.",
 "readiness_vocabulary": [
  "SAFE_TO_REPRESENT_ONLY",
  "SAFE_REFERENCE_MODEL_ONLY",
  "STRICT_REJECT_UNTIL_NEW_EVIDENCE"
 ],
 "readiness_precedence": [
  "UNBOUND_STATIC_SKILL or NO_SETTLEMENT -> SAFE_TO_REPRESENT_ONLY",
  "BLOCKED_BY_EVIDENCE or BLOCKED_BY_CONTINUATION -> STRICT_REJECT_UNTIL_NEW_EVIDENCE",
  "BLOCKED_BY_REFERENCE_SUPPORT or REPRESENTABLE_BLOCKED -> SAFE_REFERENCE_MODEL_ONLY"
 ],
 "readiness_separation": "representation_readiness and execution_readiness are separate fields. SAFE_TO_IMPLEMENT is never assigned to a real content action.",
 "distribution_population_rule": "Unlabeled global distributions cover the full 620 canonical rows. Any bound-only view is suffixed *_bound_population_distribution.",
 "blocker_vocabulary": [
  "WAIT_ANIM_STATE",
  "DAMAGE_PACKET",
  "HEAL_PACKET",
  "MODIFIER",
  "RANDOM_TARGET",
  "PREDICATE_CALLBACK",
  "SECOND_HOP_CONTINUATION",
  "RESOURCE",
  "REFERENCE_PACKET_OTHER",
  "BEHAVIOR_AFFECTING_NODE_NOT_COMPILED",
  "UNKNOWN_OR_UNSUPPORTED"
 ],
 "blocker_normalization_rule": "Raw compiler blocker strings are normalized to the fixed class vocabulary using the M12 census's own recorded per-operation classification. Raw reasons are retained per record in raw_blocker_reasons and raw_blocker_reason_sources (reason + source_type). No equivalence between unrelated reasons is inferred.",
 "primary_blocker_precedence": [
  "DAMAGE_PACKET",
  "HEAL_PACKET",
  "SECOND_HOP_CONTINUATION",
  "MODIFIER",
  "RANDOM_TARGET",
  "PREDICATE_CALLBACK",
  "RESOURCE",
  "WAIT_ANIM_STATE",
  "REFERENCE_PACKET_OTHER",
  "BEHAVIOR_AFFECTING_NODE_NOT_COMPILED",
  "UNKNOWN_OR_UNSUPPORTED"
 ],
 "primary_blocker_note": "primary_blocker is a UI/query convenience field derived deterministically. It is not a claim that other blockers are irrelevant; all blocker classes are preserved in blocker_classes.",
 "reentry_hint_vocabulary": [
  "DAMAGE_PACKET_FIELD_SUPPORT",
  "HEAL_PACKET_SUPPORT",
  "MODIFIER_STACKING_EVIDENCE",
  "NEW_NATIVE_SPHITRATIO_EVIDENCE",
  "PREDICATE_CALLBACK_SUPPORT",
  "SECOND_HOP_ORCHESTRATION",
  "TARGET_RANDOM_CONTRACT",
  "WAITANIMSTATE_LOCAL_POLICY_REVIEW"
 ],
 "reentry_hint_rule": "Hints are emitted only for blocker classes present on the record. They are routing hints, not automated approvals.",
 "stable_query_keys": {
  "by_skill": "AvatarID:SkillID",
  "by_avatar": "AvatarID"
 },
 "indexes": [
  "by_skill",
  "by_avatar",
  "by_blocker_class",
  "by_support_status",
  "by_binding_level",
  "by_reentry_hint",
  "by_unbound_reason"
 ],
 "index_rule": "Indexes contain stable skill keys only and do not duplicate record bodies. by_skill covers all 620 canonical rows; by_avatar covers all static skill rows.",
 "future_version_diff_contract": {
  "target_version": "4.5.54",
  "performed_in_this_cr": false,
  "join_key": "AvatarID:SkillID",
  "comparable_fields": [
   "STATIC_ADDED",
   "STATIC_REMOVED",
   "TRIGGER_KEY_CHANGED",
   "ENTRY_ABILITY_CHANGED",
   "PREPARE_ABILITY_CHANGED",
   "CLOSURE_CHANGED",
   "SETTLEMENT_KIND_CHANGED",
   "BLOCKER_SET_CHANGED",
   "VERSION_PROVENANCE_CHANGED"
  ],
  "field_definitions": {
   "STATIC_ADDED": "key exists in 4.5.54 registry but not in 4.4.54 registry",
   "STATIC_REMOVED": "key exists in 4.4.54 registry but not in 4.5.54 registry",
   "TRIGGER_KEY_CHANGED": "skill_trigger_key differs",
   "ENTRY_ABILITY_CHANGED": "entry_ability differs",
   "PREPARE_ABILITY_CHANGED": "prepare_ability differs",
   "CLOSURE_CHANGED": "closure metadata differs",
   "SETTLEMENT_KIND_CHANGED": "settlement_kinds set differs",
   "BLOCKER_SET_CHANGED": "blocker_classes set differs",
   "VERSION_PROVENANCE_CHANGED": "version_relation or version_provenance_qualified differs"
  },
  "private_server_4_5_54_is_not_native_truth": true,
  "no_diff_executed": true
 },
 "runtime_authority_boundary": {
  "invariant": "Registry data NEVER satisfies GateCertificate or NATIVE_EVIDENCED.",
  "corollaries": [
   "A record becoming cleaner does not grant execution permission.",
   "Runtime still requires its own evidence-mode, readiness and gate checks.",
   "M10/M11 synthetic infrastructure remains unchanged.",
   "No registry field is an execution authority."
  ]
 },
