# Normalize text files and avoid Windows/Linux line-ending churn.
* text=auto

*.py      text eol=lf
*.pyi     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.jsonl   text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.ini     text eol=lf
*.cfg     text eol=lf
*.sh      text eol=lf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.7z      binary
*.rar     binary
*.dll     binary
*.exe     binary
*.onnx    binary
*.pt      binary
*.pth     binary
*.safetensors binary
